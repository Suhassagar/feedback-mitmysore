# ==============================================================================
# Production Environment Configuration Template
# DO NOT COMMIT ACTUAL SENSITIVE KEYS OR PASSWORDS TO SOURCE CONTROL
# Inject these values securely via your hosting provider (Render, Vercel, Railway, etc.)
# ==============================================================================

NODE_ENV=production
PORT=8081

# Cryptographic & Session Secrets (Must be at least 32 characters of high-entropy randomness)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Do not leave placeholder values; production boot will reject known defaults.
SESSION_SECRET=generate_and_paste_a_unique_64_char_hex_secret_here
ENCRYPTION_SECRET=generate_and_paste_a_second_unique_64_char_hex_secret_here

# Database Configuration (TiDB Cloud / AWS RDS / Managed MySQL)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_cloud_username
DB_PASSWORD=your_tidb_cloud_password
DB_NAME=college_feedback_system
DB_SSL=true
# Strict SSL verification (true by default). Set to false only if using self-signed certs without CA bundle
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA certificate string for managed database verification
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Groq LLM API Key (for Copilot and Automated Remarks)
GROQ_API_KEY=gsk_your_groq_production_api_key_here

# Cloudinary Storage (for Department Logos & Avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Automated Email Notifications (Gmail SMTP with App Password)
EMAIL_USER=feedback.mitmysore@gmail.com
EMAIL_PASS=your_gmail_16_character_app_password

# Public Application URLs (Must start with https:// in production)
BACKEND_URL=https://mit-feedback-api.onrender.com
FRONTEND_URL=https://mitmysore.vercel.app

# Optional: Comma-separated list of additional verified institutional origins
# ADDITIONAL_ALLOWED_ORIGINS=https://preview-internal.mitmysore.in,https://feedback-portal.mitmysore.in
