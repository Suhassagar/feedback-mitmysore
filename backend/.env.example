# ==========================================
# MIT Mysore Feedback System - Backend Environment Template
# Duplicate this file as .env and fill in your credentials
# ==========================================

# Server Configuration
PORT=8081
NODE_ENV=development

# Database Configuration (MySQL / TiDB Cloud)
DB_HOST=your_database_host_here
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=college_feedback_system
DB_SSL=false

# Session Security (Generate a long random string: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_secure_random_string_in_production

# Frontend Origin URL (for CORS and email callback links)
FRONTEND_URL=https://mitmysore.vercel.app

# Automated Email Notification Service (Gmail SMTP)
EMAIL_USER=your_institution_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password

# Artificial Intelligence Copilot (Groq Cloud API Key)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloudinary Media Assets (Optional - for profile avatars & institutional logos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
